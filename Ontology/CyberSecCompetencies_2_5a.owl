    <owl:Class rdf:about="https://w3id.org/cyberseconto/RCyzScx4gyR5iDUaSnNWrcM">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RDZ3TKmq2Z65luzShERl2Ua"/>
        <rdfs:subClassOf>
