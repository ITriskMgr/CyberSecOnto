        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use equipment and tools safely</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cyberseconto/RDEgYIoeOEKdUzt3KxYPH2N -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDEgYIoeOEKdUzt3KxYPH2N">
