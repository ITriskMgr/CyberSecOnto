    <!-- https://w3id.org/cyberseconto/RDFml0D8ArCYJTpZi40hxhI -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDFml0D8ArCYJTpZi40hxhI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RBqnxx1zVjPRIA2mkjt8MT4"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
