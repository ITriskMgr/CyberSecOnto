    <!-- https://w3id.org/cyberseconto/Rp09po04nPrD998KyGe3LO -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/Rp09po04nPrD998KyGe3LO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R75jAr72W7zhgE8qxooQVLi"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACA0010 Measurement and estimation</rdfs:label>
