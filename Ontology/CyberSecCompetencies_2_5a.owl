    <owl:Class rdf:about="https://w3id.org/cyberseconto/RCAiif1LBameopbXkbVkai5">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R7JiLZoiay7ZiT2ydhLT8Ua"/>
        <rdfs:subClassOf>
            <owl:Restriction>
