                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R9HO6D14vBSxVOyKuOn6rcT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R9PtsDSJoIr3QT8tHNFMR8O"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversaries may search compromised systems to find and obtain insecurely stored credentials. These credentials can be stored and/or misplaced in many locations on a system, including plaintext files (e.g. Bash History), operating system or application-specific repositories (e.g. Credentials in Registry), or other specialized files/artifacts (e.g. Private Keys).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAC1552</rdfs:label>
        <rdfs:label xml:lang="en">Unsecured Credentials</rdfs:label>
    </owl:Class>
    


