    <owl:Ontology rdf:about="https://w3id.org/cyberseconto/cyberseconto">
        <owl:versionIRI rdf:resource="https://w3id.org/cyberseconto/2.5a/cyberseconto"/>
        <owl:versionInfo>2.5a</owl:versionInfo>
        <rdfs:label xml:lang="en">CyberSecOnto: cybersecurity competencies ontology</rdfs:label>
