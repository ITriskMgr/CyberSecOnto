    <owl:Class rdf:about="https://w3id.org/cyberseconto/RB3nyB5gUH8EZIRFiWjHCzL">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RDXYXpK9hd858Q0eDWBE11x"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T0900	Provide development guidance and assist in the identification, implementation and maintenance of organization information privacy policies and procedures in coordination with organization management and administration and legal counsel</rdfs:label>
    </owl:Class>
    


