    <!-- https://w3id.org/cyberseconto/RClY3PCtkm0uI8ZGY2szZTY -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RClY3PCtkm0uI8ZGY2szZTY">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R9HiA9CHy3iifpybBgB940"/>
        <rdfs:subClassOf>
            <owl:Restriction>
