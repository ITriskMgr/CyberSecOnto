            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BKH0008</rdfs:label>
        <rdfs:label xml:lang="fr">Connaissance de la mission et des processus d&apos;affaires de l&apos;organisation.</rdfs:label>
