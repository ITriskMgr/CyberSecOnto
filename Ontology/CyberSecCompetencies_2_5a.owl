    <!-- https://w3id.org/cyberseconto/RDEOwE18NSD9MUiI9CMQXYH -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDEOwE18NSD9MUiI9CMQXYH">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RCnDm69fCnQgyzX1dGX1qyp"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R1QOqSe4jhte7VkvJ387SI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R7MIt4pzhRPwE5ACVEB31B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversaries may communicate using the Domain Name System (DNS) application layer protocol to avoid detection/network filtering by blending in with existing traffic. Commands to the remote system, and often the results of those commands, will be embedded within the protocol traffic between the client and server.

The DNS protocol serves an administrative function in computer networking and thus may be very common in environments. DNS traffic may also be allowed even before network authentication is completed. DNS packets contain many fields and headers in which data can be concealed. Often known as DNS tunneling, adversaries may abuse DNS to communicate with systems under their control within a victim network while also mimicking normal, expected traffic.</rdfs:comment>
        <rdfs:label xml:lang="en">DNS</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAC1071.004</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cyberseconto/RDESfFi1cD9iOVKnN7CtKGP -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDESfFi1cD9iOVKnN7CtKGP">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R9RleS873TxRxY3oedY42Sc"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For more than 50 years, ISACA® (isaca.org) has advanced the best talent, expertise and learning in
technology. ISACA equips individuals with knowledge, credentials, education and community to progress their careers and transform their organizations and enables enterprises to train and build quality teams. ISACA is a global professional association and learning organization with 145,000 members who work in information security, governance, assurance, risk and privacy. It has a presence in 188 countries, including more than 220 chapters worldwide.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISACA</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cyberseconto/RDESpKwIhr2RmcLSgRMn4rG -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDESpKwIhr2RmcLSgRMn4rG">
