    <!-- https://w3id.org/cyberseconto/RBJ8LVN0vQja8KPn3kEY5Or -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RBJ8LVN0vQja8KPn3kEY5Or">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RCIpKLqUVC6kRBUCWvfAepz"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
