    <!-- https://w3id.org/cyberseconto/RCDu4XdFmK7yijD9WZZ1CnH -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RCDu4XdFmK7yijD9WZZ1CnH">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RCNHpovbrqohoXw2XrlDtjm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
