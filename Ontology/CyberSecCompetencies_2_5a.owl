    <!-- https://w3id.org/cyberseconto/R7osjoGCyNe4AoJKWxn53il -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/R7osjoGCyNe4AoJKWxn53il">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/Rm7WXLqyZBTWhCTH7RzIrv"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R9PtsDSJoIr3QT8tHNFMR8O"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversaries may use SID-History Injection to escalate privileges and bypass access controls. The Windows security identifier (SID) is a unique value that identifies a user or group account. SIDs are used by Windows security in both security descriptors and access tokens. An account can hold additional SIDs in the SID-History Active Directory attribute, allowing inter-operable account migration between domains (e.g., all values in SID-History are included in access tokens).

With Domain Administrator (or equivalent) rights, harvested or well-known SID values may be inserted into SID-History to enable impersonation of arbitrary users/groups such as Enterprise Administrators. This manipulation may result in elevated access to local resources and/or access to otherwise inaccessible domains via lateral movement techniques such as Remote Services, Windows Admin Shares, or Windows Remote Management.</rdfs:comment>
        <rdfs:label xml:lang="en">SID-History Injection</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T1134.005</rdfs:label>
    </owl:Class>
    


