        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R9HzsjTOLMxDRBzAOaLGKdd"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R2LAJF2isZxRf9DCVkneul"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/RC6JxNIoofesvAsYF9bvCDq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An adversary may add the Global Administrator role to an adversary-controlled account to maintain persistent access to an Office 365 tenant. With sufficient permissions, a compromised account can gain almost unlimited access to data and settings (including the ability to reset the passwords of other admins) via the global admin role.</rdfs:comment>
        <rdfs:label xml:lang="en">Add Office 365 Global Administrator Role</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T1098.003</rdfs:label>
    </owl:Class>
    


