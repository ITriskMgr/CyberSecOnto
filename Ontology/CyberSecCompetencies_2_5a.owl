        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use capabilities to prevent successful credential access by adversaries; including blocking forms of credential dumping.</rdfs:comment>
        <rdfs:label xml:lang="en">Credential Access Protection</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M1043</rdfs:label>
    </owl:Class>
    


