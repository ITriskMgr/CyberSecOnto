        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Develops cyber indicators to maintain awareness of the status of the highly dynamic operating environment. Collects, processes, analyzes, and disseminates cyber threat/warning assessments.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AN-TWA-001</rdfs:label>
        <rdfs:label xml:lang="en">Threat/Warning Analyst</rdfs:label>
    </owl:Class>
    


