    <!-- https://w3id.org/cyberseconto/RDBhN8OkQTXt00H4atiKfYm -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDBhN8OkQTXt00H4atiKfYm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RCNHpovbrqohoXw2XrlDtjm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
