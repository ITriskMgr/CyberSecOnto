    </owl:Class>
    


    <!-- https://w3id.org/cyberseconto/RB7dl3vkVyX88t5dvYLE6LC -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RB7dl3vkVyX88t5dvYLE6LC">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R8RYItrUM7hpmNr43oDP6Gx"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
