    <!-- https://w3id.org/cyberseconto/RCmk7SIisbiIeYz07BYfch0 -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RCmk7SIisbiIeYz07BYfch0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R9HzsjTOLMxDRBzAOaLGKdd"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/RDtmX7D2swsW7milcOVsqc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/RP3rrx26Q7NKYdBVCGr4Jq"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Adversaries may modify the SSH authorized_keys file to maintain persistence on a victim host. Linux distributions and macOS commonly use key-based authentication to secure the authentication process of SSH sessions for remote management. The authorized_keys file in SSH specifies the SSH keys that can be used for logging into the user account for which the file is configured. This file is usually found in the user&apos;s home directory under &lt;user-home&gt;/.ssh/authorized_keys. Users may edit the system’s SSH config file to modify the directives PubkeyAuthentication and RSAAuthentication to the value &quot;yes&quot; to ensure public key and RSA authentication are enabled. The SSH config file is usually located under /etc/ssh/sshd_config.</rdfs:comment>
        <rdfs:label xml:lang="en">SSH Authorized Keys</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T1098.004</rdfs:label>
    </owl:Class>
    


