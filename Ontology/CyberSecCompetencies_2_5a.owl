        <dcterms:creator>Marc-André Léger</dcterms:creator>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <rdfs:seeAlso rdf:resource="https://github.com/ITriskMgr/CyberSecOnto"/>
    </owl:Ontology>
    


