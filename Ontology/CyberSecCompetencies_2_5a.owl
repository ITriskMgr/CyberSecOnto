    <!-- https://w3id.org/cyberseconto/RDGFGUpxPM42CAYcqy6kLCg -->

    <owl:Class rdf:about="https://w3id.org/cyberseconto/RDGFGUpxPM42CAYcqy6kLCg">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/RWhqGRYajLwrAdBJ3trITk"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R2LAJF2isZxRf9DCVkneul"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cyberseconto/R9FIH0JGU0cP0BhCagaD9vG"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cyberseconto/R9PtsDSJoIr3QT8tHNFMR8O"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adversaries who have the KRBTGT account password hash may forge Kerberos ticket-granting tickets (TGT), also known as a golden ticket. Golden tickets enable adversaries to generate authentication material for any account in Active Directory.

Using a golden ticket, adversaries are then able to request ticket granting service (TGS) tickets, which enable access to specific resources. Golden tickets require adversaries to interact with the Key Distribution Center (KDC) in order to obtain TGS.

The KDC service runs all on domain controllers that are part of an Active Directory domain. KRBTGT is the Kerberos Key Distribution Center (KDC) service account and is responsible for encrypting and signing all Kerberos tickets. The KRBTGT password hash may be obtained using OS Credential Dumping and privileged access to a domain controller.</rdfs:comment>
        <rdfs:label xml:lang="en">Golden Ticket</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAC1558.001</rdfs:label>
    </owl:Class>
    


