    <owl:Class rdf:about="https://w3id.org/cyberseconto/RBJ11LZ7JxLefck4WTW3cgI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cyberseconto/R7xnD5S4clK7ucf7bmryk0t"/>
        <rdfs:subClassOf>
