        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analyzes threat information from multiple sources, disciplines, and agencies across the Intelligence Community. Synthesizes and places intelligence information in context, draws insights about the possible implications.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASA</rdfs:label>
        <rdfs:label xml:lang="en">All-Source Analysis</rdfs:label>
    </owl:Class>
    


