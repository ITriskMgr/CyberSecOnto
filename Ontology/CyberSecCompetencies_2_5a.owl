        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analyzes data/information from one or multiple sources to conduct preparation of the environment, respond to requests for information, and submit intelligence collection and production requirements in support of planning and operations.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AN-ASA-001</rdfs:label>
        <rdfs:label xml:lang="en">All-Source Analyst</rdfs:label>
    </owl:Class>
    


